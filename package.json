{
  "name": "job-portal",
  "version": "1.0.0",
  "private": true,
  "description": "MERN Job Portal — monorepo root",
  "scripts": {
    "install:backend": "cd job-portal-backend && npm install --include=dev",
    "install:frontend": "cd job-portal-frontend && npm install --include=dev",
    "install:all": "npm run install:backend && npm run install:frontend",
    "build:backend": "cd job-portal-backend && npm run build",
    "build:frontend": "cd job-portal-frontend && npm run build",
    "build": "npm run install:all && npm run build:backend && npm run build:frontend",
    "start": "cd job-portal-backend && npm start",
    "dev:backend": "cd job-portal-backend && npm run dev",
    "dev:frontend": "cd job-portal-frontend && npm run dev"
  }
}
